# Local services from `docker compose up -d postgres redis`
DATABASE_URL=postgres://resumely:resumely@localhost:5442/resumely
TEST_DATABASE_URL=postgres://resumely:resumely@localhost:5442/resumely_test
REDIS_URL=redis://localhost:6389

# At least 32 characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Google AI Studio key; the worker needs it to run analyses
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Free keys allow 5 requests a minute per model; set this to stay under your limit.
# LLM_REQUESTS_PER_MINUTE=4

STORAGE_DIR=./storage

# Optional error monitoring (Sentry). Leave unset to send nothing.
# SENTRY_DSN=
# Set to the number of proxies in front of the app (1 on most hosts) so client IPs are right.
# TRUST_PROXY=1

# S3-compatible storage (AWS S3, Cloudflare R2, ...). Leave S3_BUCKET unset to use local disk.
# To try it locally: docker compose --profile s3 up -d s3mock
# S3_BUCKET=resumely
# S3_ENDPOINT=http://localhost:9010
# S3_ACCESS_KEY_ID=test
# S3_SECRET_ACCESS_KEY=test
# S3_FORCE_PATH_STYLE=true

# Lets the S3 integration test run against the local S3 server above
# TEST_S3_ENDPOINT=http://localhost:9010
