{
  "name": "resumely",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "tsx server/index.ts",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx app/.server/db/migrate.ts",
    "worker": "tsx worker/index.ts",
    "worker:dev": "tsx watch worker/index.ts",
    "eval": "tsx evals/run.ts deterministic",
    "eval:baseline": "tsx evals/run.ts deterministic --write-baseline",
    "eval:llm": "tsx evals/run.ts llm",
    "smoke": "tsx scripts/smoke.ts",
    "stub:gemini": "tsx scripts/stub-gemini.ts",
    "load-test": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@google/genai": "^2.30.0",
    "@napi-rs/canvas": "^1.0.11",
    "@node-rs/argon2": "^2.2.2",
    "@react-router/express": "^7.12.0",
    "@react-router/node": "7.12.0",
    "@react-router/serve": "7.12.0",
    "@sentry/node": "^11.8.0",
    "bullmq": "^6.3.16",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "isbot": "^5.1.31",
    "pdfjs-dist": "^5.3.93",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-dropzone": "^15.0.0",
    "react-router": "7.12.0",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@react-router/dev": "7.12.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "aws-sdk-client-mock": "^4.1.0",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.2.0",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  }
}
